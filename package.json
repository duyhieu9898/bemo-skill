{
  "name": "bemo-automation",
  "version": "1.0.0",
  "description": "Bemo Time Off Automation",
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p jsconfig.json",
    "login": "node src/commands/login.js",
    "checkout": "node src/commands/checkout.js",
    "checkout:scheduled": "node src/commands/checkout.js --scheduled",
    "sync": "node src/commands/sync.js",
    "late-days": "node src/commands/late-days.js",
    "verify-timeoff": "node src/commands/verify-timeoff.js",
    "leave": "node src/commands/leave.js",
    "timeoff-late": "node src/commands/timeoff-late.js",
    "auto": "node src/commands/auto.js",
    "cron:install": "bash scripts/setup-cron.sh",
    "cron:uninstall": "bash scripts/setup-cron.sh --remove"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "puppeteer-core": "^24.36.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  }
}
