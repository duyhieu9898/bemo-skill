{
  "name": "bemo-automation",
  "version": "1.0.0",
  "description": "Bemo Time Off Automation",
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p jsconfig.json",
    "auth": "node src/browser/login.js",
    "data:sync": "node src/timeoff/sync.js",
    "off:create": "node src/timeoff/create.js",
    "off:verify": "node src/timeoff/verify.js",
    "off:fullday": "node src/commands/leave.js",
    "workflow:late:list": "node src/workflows/late-timeoff.js list",
    "workflow:timeoff:prepare": "node src/workflows/late-timeoff.js prepare",
    "workflow:timeoff:create": "node src/workflows/late-timeoff.js create",
    "checkout": "node src/browser/checkout.js --checkout-only",
    "checkout:auto": "node src/browser/checkout.js --checkout-only --respect-overtime",
    "overtime": "node src/timeoff/overtime.js",
    "run": "npm run data:sync && npm run off:create"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "puppeteer-core": "^24.36.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  }
}
