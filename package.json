{
  "name": "bemo-automation",
  "version": "1.0.0",
  "description": "Bemo Time Off Automation",
  "main": "src/create-timeoff.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "auth": "node src/login.js",
    "data:sync": "node src/get-attendance.js && node src/get-timeoff.js && node src/compare.js",
    "off:create": "node src/create-timeoff.js",
    "off:verify": "node src/verify-timeoff.js",
    "off:fullday": "node src/create-full-day.js",
    "workflow:late:list": "node src/workflows/late-timeoff.js list",
    "workflow:timeoff:prepare": "node src/workflows/late-timeoff.js prepare",
    "workflow:timeoff:create": "node src/workflows/late-timeoff.js create",
    "checkout": "node src/check-in-out.js --checkout-only",
    "run": "npm run data:sync && npm run off:create"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "puppeteer-core": "^24.36.1"
  }
}
