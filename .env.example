BEMO_USER=your.email@example.com
BEMO_PASS=your-password
# Optional aliases accepted by the script:
# BEMO_EMAIL=your.email@example.com
# BEMO_PASSWORD=your-password
# Optional; defaults to https://bap.bemo-cloud.com when omitted:
# BEMO_SUBDOMAIN=bap
# BEMO_BASE_URL=https://bap.bemo-cloud.com
# Optional when Chrome/Chromium is not auto-detected:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome

# Required for checkout cron Telegram notifications:
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
# Optional; defaults to npm run checkout:
# JOB_COMMAND=npm run checkout
